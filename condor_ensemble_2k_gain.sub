# Amplitude test (FEASIBILITY §27): TBNN and MiNNit-hybrid with their stress scaled by a
# constant, to check whether rollout skill at r = 128 tracks stress amplitude. Gains are
# chosen to match the a-priori t = 1-10 amplitudes of MiNNit (~1.0) and the MInIT-energy
# models (~1.6). The no-closure row is the pairing check. Same 10 starting states as
# condor_ensemble_2k_abl.sub.
universe       = vanilla
executable     = ./run_evaluate.sh
arguments      = "dns2k_s$(seed) 128 checkpoints_2k_r128/best_model.pt 1.0 10.0 cuda 0.75 mp5 hllc --skip-exact --with-unclosed --save-history --anim-interval 0.1 --with-hybrid results/dns2k/minit_coeff_2k_r128.pt --tbnn-gain $(tg) --learned-gain $(hg) --perturb-seed $(member) --perturb-amplitude 0.01 --output-dir results/ensemble_2k_r128_gain/tg$(tg)_hg$(hg)/dns2k_s$(seed)_s$(member)"
output         = ./condor_logs/ens2kg_$(Cluster)_tg$(tg)_s$(seed)_m$(member).out
error          = ./condor_logs/ens2kg_$(Cluster)_tg$(tg)_s$(seed)_m$(member).err
log            = ./condor_logs/ens2kg_$(Cluster).log
getenv         = True
request_cpus   = 4
request_memory = 65536
request_gpus   = 1
queue tg,hg,seed,member from (
  1.6, 1.3, 1, 0
  1.6, 1.3, 1, 1
  1.6, 1.3, 2, 0
  1.6, 1.3, 2, 1
  1.6, 1.3, 3, 0
  1.6, 1.3, 3, 1
  1.6, 1.3, 4, 0
  1.6, 1.3, 4, 1
  1.6, 1.3, 5, 0
  1.6, 1.3, 5, 1
  2.5, 1.6, 1, 0
  2.5, 1.6, 1, 1
  2.5, 1.6, 2, 0
  2.5, 1.6, 2, 1
  2.5, 1.6, 3, 0
  2.5, 1.6, 3, 1
  2.5, 1.6, 4, 0
  2.5, 1.6, 4, 1
  2.5, 1.6, 5, 0
  2.5, 1.6, 5, 1
)
