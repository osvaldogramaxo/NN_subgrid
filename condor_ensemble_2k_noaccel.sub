# r = 128 rollouts with the TBNN retrained without acceleration, theta and Mach (TASKS 28/10,
# checkpoints_2k_r128_noaccel): TBNN, MiNNit (rerun check) and hybrid; exact stress and
# old TBNN rows come from results/ensemble_2k_r128*. Merge: scratch/minit_rollout_merge.py.
universe       = vanilla
executable     = ./run_evaluate.sh
arguments      = "dns2k_s$(seed) 128 checkpoints_2k_r128_noaccel/best_model.pt 1.0 10.0 cuda 0.75 mp5 hllc --skip-exact --with-unclosed --save-history --anim-interval 0.1 --with-learned results/dns2k/minit_coeff_2k_r128.pt --with-hybrid results/dns2k/minit_coeff_2k_r128.pt --perturb-seed $(member) --perturb-amplitude 0.01 --output-dir results/ensemble_2k_r128_noaccel/dns2k_s$(seed)_s$(member)"
output         = ./condor_logs/ens2k_noaccel_$(Cluster)_s$(seed)_m$(member).out
error          = ./condor_logs/ens2k_noaccel_$(Cluster)_s$(seed)_m$(member).err
log            = ./condor_logs/ens2k_noaccel_$(Cluster).log
getenv         = True
request_cpus   = 4
request_memory = 65536
request_gpus   = 1
queue seed,member from (
  1, 0
  1, 1
  2, 0
  2, 1
  3, 0
  3, 1
  4, 0
  4, 1
  5, 0
  5, 1
)
