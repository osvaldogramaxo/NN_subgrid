# Does the sub-grid term matter more at larger filters? 1% rollout ensemble at r = 32, 64,
# every closure, each with the models trained for that filter on dns_khi. FEASIBILITY §21.
universe       = vanilla
executable     = ./run_evaluate.sh
arguments      = "$(data) $(r) checkpoints_r$(r)/best_model.pt 1.0 10.0 cuda 0.75 mp5 hllc --with-unclosed --save-history --anim-interval 0.1 --with-learned results/filter_scan/minit_coeff_r$(r).pt --with-hybrid results/filter_scan/minit_coeff_r$(r).pt --perturb-seed $(seed) --perturb-amplitude 0.01 --output-dir results/ensemble_r$(r)/$(data)_s$(seed)"
output         = ./condor_logs/ensr_$(Cluster)_r$(r)_$(data)_s$(seed).out
error          = ./condor_logs/ensr_$(Cluster)_r$(r)_$(data)_s$(seed).err
log            = ./condor_logs/ensr_$(Cluster).log
getenv         = True
request_cpus   = 4
request_memory = 24576
request_gpus   = 1
queue r,data,seed from (
  32, dns_khi, 0
  32, dns_khi, 1
  32, dns_khi, 2
  32, dns_khi, 3
  32, dns_khi_s1, 0
  32, dns_khi_s1, 1
  32, dns_khi_s1, 2
  32, dns_khi_s1, 3
  64, dns_khi, 0
  64, dns_khi, 1
  64, dns_khi, 2
  64, dns_khi, 3
  64, dns_khi_s1, 0
  64, dns_khi_s1, 1
  64, dns_khi_s1, 2
  64, dns_khi_s1, 3
)
