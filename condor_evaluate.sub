# ==============================================================================
# condor_evaluate.sub
# HTCondor submit file for CRMHD-TBNN Rollout Evaluation Benchmark
# ==============================================================================

universe       = vanilla
executable     = ./run_evaluate.sh

# Arguments: <data_dir> <coarsening_factor> <checkpoint> <t_start> <t_end> <device> [<cfl>] [<reconstruction>] [<riemann_solver>]
arguments = "test1 4 checkpoints/best_model.pt 5.0 10.0 cuda 0.3 mp5 hll --make-anim --save-history --anim-interval 0.1 --anim-fps 10"

# Output log files
output         = ./condor_logs/eval_$(Cluster)_$(Process).out
error          = ./condor_logs/eval_$(Cluster)_$(Process).err
log            = ./condor_logs/eval_$(Cluster)_$(Process).log

# Environment
getenv         = True

# Resources
request_cpus   = 8
request_memory = 32768
request_gpus   = 1

queue 1
