# TBNN shape x MInIT-ODE energy (FEASIBILITY §26): the hybrid with its MiNNit energy replaced by the
# refitted cell-by-cell MInIT ODE, seeded at its own equilibrium (no DNS information). The TBNN and
# MiNNit-hybrid rows rerun as a pairing check. Same 10 starting states as condor_ensemble_2k_abl.sub.
universe       = vanilla
executable     = ./run_evaluate.sh
arguments      = "dns2k_s$(seed) 128 checkpoints_2k_r128/best_model.pt 1.0 10.0 cuda 0.75 mp5 hllc --skip-exact --with-unclosed --save-history --anim-interval 0.1 --with-hybrid results/dns2k/minit_coeff_2k_r128.pt --hybrid-minit --minit-coefficients results/minit_fair/coeffs_2k_r128_cell.json --perturb-seed $(member) --perturb-amplitude 0.01 --output-dir results/ensemble_2k_r128_hybrid_minit/dns2k_s$(seed)_s$(member)"
output         = ./condor_logs/ens2khm_$(Cluster)_s$(seed)_m$(member).out
error          = ./condor_logs/ens2khm_$(Cluster)_s$(seed)_m$(member).err
log            = ./condor_logs/ens2khm_$(Cluster).log
getenv         = True
request_cpus   = 4
request_memory = 65536
request_gpus   = 1
queue seed,member from (
  1, 0
  1, 1
  2, 0
  2, 1
  3, 0
  3, 1
  4, 0
  4, 1
  5, 0
  5, 1
)
